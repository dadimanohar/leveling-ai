{
  "name": "leveling",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 0.0.0.0\" \"node server/index.mjs\"",
    "server": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "check": "tsc -b --pretty false && node tests/syntax.mjs && vitest run",
    "smoke": "node tests/smoke.mjs",
    "package:desktop": "npm run build && electron-builder",
    "package:source": "node scripts/package-source.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "archiver": "^7.0.1",
    "concurrently": "^9.2.1",
    "lucide-react": "^0.468.0",
    "nodemailer": "^7.0.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "electron": "^38.2.1",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.leveling.ai",
    "productName": "leveling",
    "files": [
      "dist/**/*",
      "server/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
